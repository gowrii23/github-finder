# JobPulse environment variables
# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit .env to git

# --- Telegram (instant alerts, score >= 85) ---
# Create bot: Telegram -> @BotFather -> /newbot
# Get chat_id: message your bot, then run  npm run telegram:chat-id
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_after_messaging_bot

# --- Email (daily digest, score >= 70) ---
# Gmail: enable 2FA -> App Passwords -> generate for "JobPulse"
EMAIL_TO=your.email@gmail.com
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# --- Job matching ---
MIN_SCORE_NOTIFY=70
MIN_SCORE_WHATSAPP_INSTANT=85
MIN_SCORE_SHOW=40
RETENTION_DAYS=30

# --- Owner profile (used in notifications) ---
OWNER_NAME=Gowrishankar Sekar
OWNER_LOCATION=Chennai, India

# --- Optional: database path ---
DATABASE_PATH=./backend/db/jobpulse.db
